# 7Doses (ยาเจ็ดเม็ด) - Supabase & PWA Environment Variables
# Copy this file to .env.local to enable live Supabase Cloud synchronization

# 1. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Public Key (Safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note: If these keys are not set, 7Doses runs in Offline/Local Storage mode automatically.
